{
  "go.lintTool": "golangci-lint",
  "go.lintFlags": [],

  "go.formatTool": "goimports",
  "go.formatFlags": [
    "-local",
    "identity/,catalog/,apigateway/"
  ],

  "[go]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },

  "tooltitude.pb.importsCheckEnabled": false,
  "tooltitude.pb.refsCheckEnabled": false
}
